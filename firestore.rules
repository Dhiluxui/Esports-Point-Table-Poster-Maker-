rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    function isValidTournament(data) {
      return data.keys().hasAll(['ownerId', 'name', 'slots', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.slots is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhase(data, tournamentId) {
      return data.keys().hasAll(['tournamentId', 'phaseNumber', 'name', 'groupsCount', 'matchesPerGroup', 'createdAt', 'updatedAt'])
        && data.tournamentId == tournamentId
        && data.phaseNumber is number
        && data.name is string && data.name.size() <= 100
        && data.groupsCount is number
        && data.matchesPerGroup is number
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['qualifiedPerGroup']) || data.qualifiedPerGroup is number)
        && (!data.keys().hasAny(['isFinal']) || data.isFinal is bool)
        && (!data.keys().hasAny(['championRushEnabled']) || data.championRushEnabled is bool);
    }

    match /tournaments/{tournamentId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() 
        && isValidId(tournamentId) 
        && isValidTournament(incoming()) 
        && incoming().createdAt == request.time 
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn() 
        && isValidId(tournamentId) 
        && existing().ownerId == request.auth.uid 
        && isValidTournament(incoming()) 
        && incoming().ownerId == existing().ownerId 
        && incoming().createdAt == existing().createdAt 
        && incoming().updatedAt == request.time 
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slots', 'updatedAt']);
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      match /phases/{phaseId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid;
        allow create: if isSignedIn() 
          && isValidId(tournamentId) 
          && isValidId(phaseId) 
          && isValidPhase(incoming(), tournamentId) 
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid
          && incoming().createdAt == request.time 
          && incoming().updatedAt == request.time;
        allow update: if isSignedIn() 
          && isValidId(tournamentId) 
          && isValidId(phaseId) 
          && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid
          && isValidPhase(incoming(), tournamentId)
          && incoming().tournamentId == existing().tournamentId 
          && incoming().createdAt == existing().createdAt 
          && incoming().updatedAt == request.time 
          && incoming().diff(existing()).affectedKeys().hasOnly(['phaseNumber', 'name', 'groupsCount', 'matchesPerGroup', 'qualifiedPerGroup', 'isFinal', 'championRushEnabled', 'updatedAt']);
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
